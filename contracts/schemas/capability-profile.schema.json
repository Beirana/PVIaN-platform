{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pvi.invalid/schemas/capability-profile.schema.json",
  "title": "PVI Capability Profile v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile_id",
    "profile_version",
    "subject",
    "assurance",
    "model_api_capabilities",
    "endpoint_capabilities",
    "runtime_interop",
    "probe_summary"
  ],
  "properties": {
    "schema_version": { "const": "pvi.capability-profile/v1" },
    "profile_id": { "type": "string", "minLength": 1 },
    "profile_version": { "type": "string", "minLength": 1 },
    "subject": { "$ref": "#/$defs/subject" },
    "assurance": { "$ref": "#/$defs/assurance" },
    "model_api_capabilities": {
      "type": "object",
      "required": [
        "messages",
        "multimodal",
        "structured_output",
        "tool_calling",
        "reasoning",
        "usage_context",
        "streaming",
        "sampling_observability",
        "builtin_tools"
      ],
      "properties": {
        "messages": { "$ref": "#/$defs/status_capability" },
        "multimodal": { "$ref": "#/$defs/status_capability" },
        "structured_output": { "$ref": "#/$defs/status_capability" },
        "tool_calling": { "$ref": "#/$defs/tool_calling" },
        "reasoning": { "$ref": "#/$defs/reasoning" },
        "usage_context": { "$ref": "#/$defs/status_capability" },
        "streaming": { "$ref": "#/$defs/status_capability" },
        "sampling_observability": { "$ref": "#/$defs/sampling" },
        "builtin_tools": { "$ref": "#/$defs/status_capability" }
      },
      "additionalProperties": false
    },
    "endpoint_capabilities": {
      "type": "object",
      "required": [
        "stream_transport",
        "usage_reporting",
        "routing_transparency",
        "fallback_behavior",
        "raw_evidence_availability",
        "model_disclosure"
      ],
      "properties": {
        "stream_transport": { "$ref": "#/$defs/capability_status" },
        "usage_reporting": { "$ref": "#/$defs/capability_status" },
        "routing_transparency": { "$ref": "#/$defs/capability_status" },
        "fallback_behavior": { "$ref": "#/$defs/capability_status" },
        "raw_evidence_availability": { "$ref": "#/$defs/capability_status" },
        "model_disclosure": { "$ref": "#/$defs/capability_status" }
      },
      "additionalProperties": false
    },
    "runtime_interop": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mcp_client", "skills", "tool_execution", "sandbox_evidence_adapter"],
      "properties": {
        "mcp_client": { "const": "external_runtime_managed" },
        "skills": { "const": "external_runtime_managed" },
        "tool_execution": { "const": "consumer_managed" },
        "sandbox_evidence_adapter": { "type": "string" }
      }
    },
    "probe_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "probe_suite_version",
        "completed_probe_ids",
        "inconclusive_probe_ids",
        "next_revalidation_due"
      ],
      "properties": {
        "probe_suite_version": { "type": "string", "minLength": 1 },
        "completed_probe_ids": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        },
        "inconclusive_probe_ids": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        },
        "next_revalidation_due": { "type": ["string", "null"], "format": "date-time" }
      }
    }
  },
  "$defs": {
    "endpoint_kind": {
      "enum": [
        "official_direct",
        "managed_cloud",
        "broker_gateway",
        "self_hosted_gateway",
        "local_open_weights",
        "local_opaque_runtime",
        "unknown"
      ]
    },
    "assurance_status": {
      "enum": ["verified", "governed", "declared_unverified", "unknown", "failed"]
    },
    "protocol_fidelity": {
      "enum": [
        "native",
        "documented_translation",
        "observed_translation",
        "lossy_translation",
        "unknown"
      ]
    },
    "capability_status": {
      "enum": [
        "supported",
        "unsupported",
        "unknown",
        "not_tested",
        "not_applicable",
        "inconclusive"
      ]
    },
    "evidence_ids": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "assurance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity_assurance",
        "model_provenance_assurance",
        "protocol_fidelity_assurance",
        "data_handling_assurance",
        "operational_assurance",
        "protocol_fidelity",
        "usage_notes"
      ],
      "properties": {
        "identity_assurance": { "$ref": "#/$defs/assurance_status" },
        "model_provenance_assurance": { "$ref": "#/$defs/assurance_status" },
        "protocol_fidelity_assurance": { "$ref": "#/$defs/assurance_status" },
        "data_handling_assurance": { "$ref": "#/$defs/assurance_status" },
        "operational_assurance": { "$ref": "#/$defs/assurance_status" },
        "protocol_fidelity": { "$ref": "#/$defs/protocol_fidelity" },
        "usage_notes": { "type": "array", "items": { "type": "string" } }
      }
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "endpoint_id",
        "endpoint_kind",
        "provider_id",
        "api_surface",
        "api_version",
        "model_requested",
        "model_reported",
        "model_revision",
        "deployment_id",
        "region",
        "relevant_configuration_digest",
        "observed_at"
      ],
      "properties": {
        "endpoint_id": { "type": "string", "minLength": 1 },
        "endpoint_kind": { "$ref": "#/$defs/endpoint_kind" },
        "provider_id": { "type": "string", "minLength": 1 },
        "api_surface": { "type": "string", "minLength": 1 },
        "api_version": { "type": "string", "minLength": 1 },
        "model_requested": { "type": "string", "minLength": 1 },
        "model_reported": { "type": ["string", "null"] },
        "model_revision": { "type": "string", "minLength": 1 },
        "deployment_id": { "type": ["string", "null"] },
        "region": { "type": ["string", "null"] },
        "relevant_configuration_digest": { "type": ["string", "null"] },
        "observed_at": { "type": "string", "format": "date-time" }
      }
    },
    "status_capability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["advertised", "observed", "effective", "evidence_ids"],
      "properties": {
        "advertised": { "$ref": "#/$defs/capability_status" },
        "observed": { "$ref": "#/$defs/capability_status" },
        "effective": { "$ref": "#/$defs/capability_status" },
        "evidence_ids": { "$ref": "#/$defs/evidence_ids" }
      }
    },
    "tool_calling": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "advertised",
        "observed",
        "effective",
        "representation",
        "streaming_arguments",
        "multiple_calls_per_turn",
        "parallel_calls",
        "stable_call_result_correlation",
        "native_tool_result_continuation",
        "evidence_ids"
      ],
      "properties": {
        "advertised": { "$ref": "#/$defs/capability_status" },
        "observed": { "$ref": "#/$defs/capability_status" },
        "effective": { "$ref": "#/$defs/capability_status" },
        "representation": {
          "enum": [
            "native_structured",
            "native_structured_streaming",
            "json_text_simulation",
            "xml_text_simulation",
            "markdown_text_simulation",
            "provider_builtin",
            "gateway_builtin",
            "unsupported",
            "unknown"
          ]
        },
        "streaming_arguments": { "$ref": "#/$defs/capability_status" },
        "multiple_calls_per_turn": { "$ref": "#/$defs/capability_status" },
        "parallel_calls": { "$ref": "#/$defs/capability_status" },
        "stable_call_result_correlation": { "$ref": "#/$defs/capability_status" },
        "native_tool_result_continuation": { "$ref": "#/$defs/capability_status" },
        "evidence_ids": { "$ref": "#/$defs/evidence_ids" }
      }
    },
    "reasoning": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "advertised",
        "observed",
        "effective",
        "exposure",
        "continuation_artifact",
        "evidence_ids"
      ],
      "properties": {
        "advertised": { "$ref": "#/$defs/capability_status" },
        "observed": { "$ref": "#/$defs/capability_status" },
        "effective": { "$ref": "#/$defs/capability_status" },
        "exposure": {
          "enum": [
            "none",
            "token_usage_only",
            "summary_only",
            "visible_reasoning_text",
            "opaque_continuation_artifact",
            "mixed",
            "unknown"
          ]
        },
        "continuation_artifact": { "$ref": "#/$defs/capability_status" },
        "evidence_ids": { "$ref": "#/$defs/evidence_ids" }
      }
    },
    "sampling": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observed",
        "sample_access",
        "seed_control",
        "decoding_controls",
        "top_k_logprobs",
        "full_vocab_logits",
        "local_weights_access",
        "tokenizer_access",
        "evidence_ids"
      ],
      "properties": {
        "observed": { "$ref": "#/$defs/capability_status" },
        "sample_access": {
          "enum": [
            "sample_only",
            "seed_control",
            "decoding_controls",
            "top_k_logprobs",
            "full_vocab_logits",
            "local_weights_and_runtime",
            "unknown"
          ]
        },
        "seed_control": { "$ref": "#/$defs/capability_status" },
        "decoding_controls": { "$ref": "#/$defs/capability_status" },
        "top_k_logprobs": { "$ref": "#/$defs/capability_status" },
        "full_vocab_logits": { "$ref": "#/$defs/capability_status" },
        "local_weights_access": { "$ref": "#/$defs/capability_status" },
        "tokenizer_access": { "$ref": "#/$defs/capability_status" },
        "evidence_ids": { "$ref": "#/$defs/evidence_ids" }
      }
    }
  }
}
