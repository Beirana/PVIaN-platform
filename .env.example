PVI_HOST=0.0.0.0
PVI_PORT=5100
PVI_DATA_DIR=data
PVI_CONTRACT_DIR=contracts
PVI_LOG_LEVEL=INFO
PVI_ENVIRONMENT=development
PVI_REQUIRE_DATA_VALIDATION=true
PVI_FAIL_STARTUP_ON_INVALID_DATA=true

# Optional online Probe Runner. Never commit a real key.
#
# This repository implements Yunwu and Bailian qualification profiles. Their
# variables do not enable requests by themselves: qualification still requires
# explicit network/cost flags and the gateway only exposes current callable routes.
# Copy this file to .env locally, set only the API-key values there, and keep
# .env untracked. Do not put real prompts, responses, reasoning, or keys in
# reports or committed configuration.

# Yunwu OpenAI-compatible gateway. Keep MODEL empty until the provider's
# requested/reported model identity is confirmed by a controlled qualification
# run; do not infer it from a UI display name.
PVI_PROBE_YUNWU_API_KEY=
# Set the credential only in your local .env.
PVI_PROBE_YUNWU_BASE_URL=https://yunwu.ai/v1
# Legacy single-model Probe compatibility only. New qualification uses
# config/provider-profiles/ and live catalog discovery; do not set a model here.
PVI_PROBE_YUNWU_MODEL=
PVI_PROBE_YUNWU_TRANSPORT=openai_compatible_chat_completions

# Alibaba Cloud Model Studio (Bailian), China (Beijing) workspace identity.
# The API host below is the non-secret value supplied from the Bailian console.
# Keep credentials in the dedicated project variable, rather than the vendor
# SDK's generic DASHSCOPE_API_KEY, so every provider remains independently scoped.
PVI_PROBE_BAILIAN_API_KEY=
# Set the credential only in your local .env.
PVI_PROBE_BAILIAN_REGION=cn-beijing
PVI_PROBE_BAILIAN_API_HOST=llm-example.cn-beijing.maas.aliyuncs.com # gitleaks:allow -- public example host

# Initial qualification surface: OpenAI-compatible Chat Completions.
# When this profile is implemented, the runner must freeze this transport,
# base URL, and path into the evidence manifest. Model selection and thinking
# request variants live in config/provider-profiles/, never in this ENV file.
PVI_PROBE_BAILIAN_OPENAI_BASE_URL=https://llm-example.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
PVI_PROBE_BAILIAN_OPENAI_CHAT_PATH=/chat/completions
PVI_PROBE_BAILIAN_OPENAI_TRANSPORT=openai_compatible_chat_completions

# Reserved for a future DashScope-native profile. It is deliberately not an
# active fallback for the OpenAI-compatible profile.
PVI_PROBE_BAILIAN_DASHSCOPE_BASE_URL=https://llm-example.cn-beijing.maas.aliyuncs.com/api/v1
PVI_PROBE_BAILIAN_DASHSCOPE_TRANSPORT=dashscope_native

# DeepSeek official API (api-docs.deepseek.com). Candidate profiles target the
# exact catalog IDs deepseek-v4-pro / deepseek-v4-flash. The official base URL
# carries no path component; leave it exactly as below. Set the key value only
# in an untracked local .env.
PVI_PROBE_DEEPSEEK_API_KEY=
# Set the credential only in your local .env.
PVI_PROBE_DEEPSEEK_OPENAI_BASE_URL=https://api.deepseek.com

# Moonshot Kimi official API, China endpoint (platform.kimi.com console key).
# The catalog target is the exact ID kimi-k3. A global-console key
# (platform.kimi.ai / api.moonshot.ai) is a different endpoint identity and is
# not covered by the current profile.
PVI_PROBE_MOONSHOT_API_KEY=
# Set the credential only in your local .env.
PVI_PROBE_MOONSHOT_OPENAI_BASE_URL=https://api.moonshot.cn/v1

# OpenRouter aggregation gateway (openrouter.ai). Candidate profiles target the
# exact catalog slugs anthropic/claude-sonnet-5 and openai/gpt-5.6-sol; suffixed
# variants (:nitro, :floor, :batch, -pro) are separate identities. Exact-identity
# requests must carry provider.allow_fallbacks=false (frozen in recommended
# defaults). Set the key value only in an untracked local .env.
PVI_PROBE_OPENROUTER_API_KEY=
# Set the credential only in your local .env.
PVI_PROBE_OPENROUTER_OPENAI_BASE_URL=https://openrouter.ai/api/v1

# Zhipu BigModel GLM Coding Plan (docs.bigmodel.cn/cn/coding-plan). Subscription
# endpoint: the base URL below is the coding-plan path on the shared official
# host, and the key MUST be a Coding Plan key created under the plan console.
# Official docs state Coding Plan / Token Plan / pay-as-you-go keys and base
# URLs are fully isolated and must be used in matching pairs — mixing them
# causes 401/403 or unexpected pay-as-you-go billing. The catalog target is the
# exact ID glm-5.3. Billing is subscription (window quota), so ledger cost
# estimates for this provider are intentionally unknown, never zero.
PVI_PROBE_BIGMODEL_CODING_API_KEY=
# Set the credential only in your local .env.
PVI_PROBE_BIGMODEL_CODING_OPENAI_BASE_URL=https://open.bigmodel.cn/api/coding/paas/v4

# AiGoCode relay gateway (docs.aigocode.com). OpenAI-compatible station with
# MANDATORY per-vendor tokens (scoping verified read-only 2026-08-18: each token
# lists exactly one vendor's models, zero cross-vendor visibility):
#   CODEX_1.2  -> gpt-5.4/5.5, gpt-5.6-luna/terra/sol, codex-auto-review, gpt-image-2
#   CLAUDE_3.9 -> claude-haiku/opus/sonnet/fable families
#   GROK_2.5   -> grok-4.5, grok-4.6
#   GEMINI_1   -> gemini-3.x families
# Provider profiles bind the matching variable per model group; never point a
# profile at another vendor's token. Station WAF blocks generic Python UAs
# (Cloudflare 1010); browser-style and OpenAI-SDK-style UAs pass — the probe and
# gateway HTTP stack must be confirmed live before qualification. Station
# per-token prices sit behind the console login, so ledger cost estimates for
# this provider are intentionally unknown, never zero.
PVI_PROBE_AIGOCODE_CODEX_1.2_API_KEY=
# Set the credential only in your local .env.
PVI_PROBE_AIGOCODE_CLAUDE_3.9_API_KEY=
# Set the credential only in your local .env.
PVI_PROBE_AIGOCODE_GROK_2.5_API_KEY=
# Set the credential only in your local .env.
PVI_PROBE_AIGOCODE_GEMINI_1_API_KEY=
# Set the credential only in your local .env.
PVI_PROBE_AIGOCODE_OPENAI_BASE_URL=https://api.aigocode.com/v1

# AiGoCode Anthropic-native surface (operator-provided via CCSwitch config).
# Same host as the OpenAI-compatible face but the Anthropic Messages protocol
# (/v1/messages); authenticated with the SAME Claude-group key as above — no
# separate credential. The gateway pins anthropic-version + claude-cli style
# UA on this surface (station WAF rejects generic python UA with 502).
PVI_PROBE_AIGOCODE_ANTHROPIC_BASE_URL=https://api.aigocode.com

# Xiaomi MiMo Token Plan subscription endpoint (mimo.mi.com/docs). The plan is
# officially restricted to coding tools with API automation forbidden — the
# operator has explicitly accepted this gray zone for a bounded trial. The tp-
# key and the token-plan base URL are isolated from the pay-as-you-go API
# (api.xiaomimimo.com/v1, sk- keys); the two must never be mixed.
PVI_PROBE_MIMO_TOKEN_PLAN_API_KEY=
# Set the credential only in your local .env.
PVI_PROBE_MIMO_TOKEN_PLAN_OPENAI_BASE_URL=https://token-plan-cn.xiaomimimo.com/v1

# Aliyun Bailian Token Plan (personal subscription) endpoint. sk-sp- key from
# the Bailian console subscription page; the pay-as-you-go Bailian key/base URL
# are NOT interchangeable (mixing never deducts plan quota), and subscription
# renewal rotates the key. Credits metering with a 7-day rolling quota; the plan
# docs restrict use to interactive coding/agent tools and forbid API-automation
# backends — the operator has explicitly accepted this gray zone (mimo
# precedent) for this platform's coding-tool forwarding on 2026-08-19.
PVI_PROBE_ALIYUN_TOKEN_PLAN_API_KEY=
# Set the credential only in your local .env.
PVI_PROBE_ALIYUN_TOKEN_PLAN_OPENAI_BASE_URL=https://token-plan.cn-beijing.maas.aliyuncs.com/compatible-mode/v1

# Self-hosted vLLM Qwen3.8-27B-FP8 behind an SSH tunnel. The operator contract
# fixes base_url/model/api_key across backend swaps; the key is a non-secret
# non-empty placeholder by design. Concurrency contract: 4 concurrent
# generations queue beyond the cap; keep >100K-prompt work at 2 concurrent.
PVI_PROBE_LOCAL_QWEN_API_KEY=dummy
PVI_PROBE_LOCAL_QWEN_OPENAI_BASE_URL=http://127.0.0.1:18000/v1

# Transparent gateway process configuration. Provider credentials remain above.
# Gateway client keys are separate from provider credentials.  Set values only
# in an untracked local .env or secret manager; the versioned registry contains
# only key IDs, state, and these environment-variable names.
PVI_GATEWAY_CLIENT_KEY_INTERNAL_PRIMARY=
# Keep an old value locally only while its registry entry is revoked, so calls
# with that known key receive 403 rather than being indistinguishable from an
# arbitrary invalid key. Never paste either value into a command, log or report.
PVI_GATEWAY_CLIENT_KEY_INTERNAL_PREVIOUS=
PVI_GATEWAY_PROFILE_DIR=config/provider-profiles
PVI_GATEWAY_CLIENT_KEY_REGISTRY_FILE=config/gateway-client-keys.json
PVI_GATEWAY_ALIAS_REGISTRY_FILE=config/public-model-aliases.json
PVI_GATEWAY_STATE_FILE=var/gateway/qualification-state-flash-0731.json
PVI_GATEWAY_HOST=127.0.0.1
PVI_GATEWAY_PORT=5200
