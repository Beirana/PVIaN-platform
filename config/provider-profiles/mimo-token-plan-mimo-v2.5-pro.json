{
  "schema_version": "pvi.provider-qualification-profile/v1",
  "profile_id": "provider-mimo-token-plan-mimo-v2-5-pro",
  "profile_version": "0.1.0",
  "lifecycle": "candidate",
  "provider": {
    "provider_id": "provider-mimo-token-plan",
    "display_name": "Xiaomi MiMo Token Plan (official subscription endpoint)",
    "region": "cn",
    "credential_environment_variable": "PVI_PROBE_MIMO_TOKEN_PLAN_API_KEY"
  },
  "endpoints": [
    {
      "endpoint_id": "endpoint-mimo-token-plan-openai-compatible",
      "route_id_prefix": "mimo-token-plan",
      "transport": "openai_compatible_chat_completions",
      "base_url_environment_variable": "PVI_PROBE_MIMO_TOKEN_PLAN_OPENAI_BASE_URL",
      "allowed_hosts": [
        "token-plan-cn.xiaomimimo.com"
      ],
      "required_base_path": "/v1",
      "chat_completions_path": "/chat/completions",
      "catalog_discovery": {
        "operation": "openai_models_list",
        "path": "/models",
        "on_unavailable": "record_inconclusive_do_not_fallback"
      },
      "qualification_enabled": true
    }
  ],
  "model_selection": {
    "strategy": "live_catalog_match",
    "selection_order": [
      "mimo_v2_5_pro"
    ],
    "targets": [
      {
        "logical_model_id": "mimo_v2_5_pro",
        "catalog_id_patterns": [
          "^mimo-v2\\.5-pro$"
        ],
        "source": {
          "kind": "official_documentation",
          "url": "https://mimo.mi.com/docs/zh-CN/quick-start/summary/model",
          "public_document_drift": "subscription endpoint identity; payg api.xiaomimimo.com and the Bailian-hosted xiaomi/mimo-v2.5-pro route are different identities that must never be mapped"
        },
        "if_absent": "record_not_discovered_do_not_substitute"
      }
    ]
  },
  "qualification": {
    "required_network_flags": [
      "allow_network",
      "confirm_cost"
    ],
    "probe_set": [
      "message",
      "stream",
      "thinking",
      "native_tool_call",
      "assistant_replay",
      "tool_result_replay",
      "usage"
    ],
    "request_variants": [
      {
        "variant_id": "baseline",
        "request_overrides": {}
      }
    ],
    "probe_request_policy": {
      "temperature": null,
      "seed": null,
      "max_output_parameter": "max_completion_tokens",
      "max_output_tokens": {
        "message": 128,
        "stream": 128,
        "thinking": 256,
        "tool": 256,
        "replay": 128
      },
      "tool_choice_mode": "auto",
      "timeout_seconds": 300,
      "retry_total_attempts": 1,
      "fallback": null
    },
    "result_rules": {
      "single_failure_means": "inconclusive",
      "model_identity": "record_requested_and_reported_model",
      "raw_content": "never_persist",
      "unsupported_parameter": "record_protocol_result_do_not_retry_with_fallback"
    },
    "enablement": {
      "required_probes": [
        "message",
        "thinking",
        "usage"
      ],
      "validity_hours": 168,
      "consecutive_failure_threshold": 5
    }
  }
}
